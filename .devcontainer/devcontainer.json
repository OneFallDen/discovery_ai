{
  "name": "discovery-ai",
  "dockerComposeFile": "docker-compose.yml",
  "service": "backend",
  "workspaceFolder": "/workspaces/discovery_ai",

  "postCreateCommand": "pnpm install",

  "forwardPorts": [3000, 5173, 5432, 6379],
  "portsAttributes": {
    "3000": { "label": "Backend" },
    "5173": { "label": "Frontend" },
    "5432": { "label": "Postgres" },
    "6379": { "label": "Redis" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    },
    "jetbrains": {
      "plugins": []
    }
  }
}
